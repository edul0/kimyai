# Kemy AI cloud-free environment
AMBIENTE=production
PORT=8000
FREE_ONLY=true
LLM_MODE=mock
ORIGENS_CORS=*
REDIS_URL=
KEMY_AUTH_USER=admin
KEMY_AUTH_PASSWORD=troque-esta-senha
KEMY_AUTH_SECRET=troque-este-segredo-longo

# Enable only when you accept each provider's free-tier limits (sem cartao, sem cobranca).
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
# NVIDIA NIM (build.nvidia.com) — gratis com creditos de trial (expiram em ~30-90 dias).
NVIDIA_API_KEY=
# Mistral (console.mistral.ai) — tier gratis ~1B tokens/mes (Codestral e otimo pra codigo).
MISTRAL_API_KEY=

# Keep disabled while FREE_ONLY=true.
OPENROUTER_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
E2B_API_KEY=
BROWSERLESS_API_KEY=
BROWSERLESS_URL=
GOTENBERG_URL=
GOTENBERG_TIMEOUT_SECONDS=90
# Use as variaveis KIMI_* quando houver outro projeto Supabase no mesmo ecossistema, como o Kanban.
KIMI_SUPABASE_URL=
KIMI_SUPABASE_ANON_KEY=
KIMI_SUPABASE_SERVICE_ROLE_KEY=

# Compatibilidade legada. Preencha so se nao estiver usando o prefixo KIMI_*.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

DEFAULT_MODEL=groq/openai/gpt-oss-120b
JOB_TTL_SECONDS=86400
SESSION_TTL_SECONDS=604800
MAX_PROMPT_CHARS=12000
